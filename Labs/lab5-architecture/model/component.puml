@startuml
title VideoHub Architecture - Component Diagram

left to right direction
skinparam nodesep 25
skinparam ranksep 45

actor User

rectangle "VideoHub System" {
  [Frontend\n(Next.js)] as FE
  [API Gateway\n(Express)] as GW
  [Auth Service] as AUTH
  [Video Service] as VS
  [Comment Service] as CS
  [Search Service] as SS
  [Notification Service] as NS
  [Data Access Layer\n(Prisma)] as DAL
  database "PostgreSQL" as DB
}

package "External Systems" {
  [Google OAuth] as GOOGLE
  [Email/SMS Gateway] as EMAIL
}

User --> FE
FE ..> GW : IRestApi
GW ..> AUTH : IAuth
GW ..> VS : IVideoOps
GW ..> CS : ICommentOps
GW ..> SS : ISearch
VS ..> NS : INotify
VS ..> SS : ISearchIndex
AUTH ..> DAL : IDataAccess
VS ..> DAL : IDataAccess
CS ..> DAL : IDataAccess
SS ..> DAL : IDataAccess
DAL --> DB
AUTH ..> GOOGLE : IGoogleOAuth
NS ..> EMAIL : IEmailGateway

@enduml
