        </mxCell>

        <mxCell id="ext" value="External Systems" style="rounded=0;html=1;align=center;verticalAlign=top;fontStyle=1;fontSize=16;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="1060" width="780" height="190" as="geometry" />
        </mxCell>

        <mxCell id="fe" value="«component»&#10;Frontend&#10;(Next.js)" style="shape=component;html=1;" vertex="1" parent="1">
