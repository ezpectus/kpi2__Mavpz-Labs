<mxfile host="app.diagrams.net">
  <diagram name="VideoHub Components">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="VideoHub Architecture - Component Diagram" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User" style="shape=umlActor;html=1;" vertex="1" parent="1">
          <mxGeometry x="275" y="55" width="30" height="75" as="geometry" />
